# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL for CORS
CLIENT_URL=http://localhost:5173

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=contact_fingerprint_db
DB_CONNECTION_LIMIT=10

# Security & JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Fingerprint Hardware Settings
# Modes: 'hardware' (real ESP32 / AS608 / R307) or 'mock' (software biometric simulation)
FINGERPRINT_MODE=mock
DEFAULT_SENSOR_TYPE=AS608
DEFAULT_DEVICE_ID=ESP32-BIO-01
ESP32_API_KEY=esp32_secret_device_token_2026

# Logging
LOG_LEVEL=info
